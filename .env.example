# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/pokedao
REDIS_URL=redis://localhost:6379
TZ=UTC

# ============================================================================
# CLAUDE CODE MCP (Optional - for enhanced Claude Code integration)
# ============================================================================
GITHUB_TOKEN=  # GitHub personal access token for MCP server

# ============================================================================
# JUSTTCG API (Primary Data Source)
# ============================================================================
# Get your API key from: https://justtcg.com/dashboard
JUSTTCG_API_KEY=tcg_your_api_key_here
JUSTTCG_RATE_LIMIT=2  # Requests per second (adjust based on your plan)

# Plan limits (for reference):
# Free: 1,000 requests/month
# Starter: 10,000 requests/month  
# Professional: 50,000 requests/month
# Max: Contact JustTCG

# ============================================================================
# TELEGRAM BOT
# ============================================================================
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id  # For Claude Code MCP notifications
TELEGRAM_ALERTS_ENABLED=false
ALERT_MIN_EDGE_BP=500
ALERT_MIN_CONFIDENCE=0.5
ALERT_MIN_PRICE_USD=50
ALERT_MAX_PER_HOUR=10
ALERT_COOLDOWN_MINUTES=15

# ============================================================================
# X (TWITTER) POSTING
# ============================================================================
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
POST_TO_X=false
DRY_RUN=true
MAX_POSTS_PER_DAY=6

# ============================================================================
# LLM MODELS (AI Thesis Generation)
# ============================================================================
# Local Ollama (preferred)
USE_OLLAMA=1
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:7b-instruct

# DeepSeek API (fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat

# ============================================================================
# PRICING & FEES
# ============================================================================
DEFAULT_FEE_BPS=350
DEFAULT_SHIPPING_USD=6
MIN_COMP_SALES=5
TFV_HALF_LIFE_DAYS=30

# ============================================================================
# SIGNAL THRESHOLDS
# ============================================================================
THESIS_MIN_COMPS_90=5
THESIS_MAX_VOL_BP=1200
THESIS_MAX_FRESH_DAYS=14
THESIS_KEEP_FLAGGED=0
THESIS_RELAXED=0

# ============================================================================
# POKESTRATEGY (VAULT EXECUTION)
# ============================================================================
EXECUTION_ENABLED=false
DAILY_SPEND_LIMIT_USD=0

# ============================================================================
# OTHER DATA SOURCES (OPTIONAL)
# ============================================================================
# eBay (for comps collection)
EBAY_APP_ID=
EBAY_CERT_ID=

# eBay Marketplace Account Deletion (MAD) Webhook
EBAY_MAD_VERIFICATION_TOKEN=GENERATE_WITH_crypto_randomBytes_32_toString_hex
EBAY_MAD_ENDPOINT_URL=https://your-domain.com/webhooks/ebay/mad

# Phygitals (blockchain marketplace)
PHYGITALS_API_KEY=

# Collector Crypt (premium marketplace)
COLLECTOR_CRYPT_API_KEY=

# ============================================================================
# MIT INTEGRATION FEATURE FLAGS
# ============================================================================
# Enhanced data validation and quality improvements
# These flags control gradual rollout of new features (backwards compatible)

# Week 1: Data Validation & Quality
USE_ENHANCED_VALIDATION=false
ROLLOUT_ENHANCED_VALIDATION=0  # 0-100% gradual rollout

USE_FUZZY_MATCHING=false
ROLLOUT_FUZZY_MATCHING=0  # 0-100% gradual rollout

USE_DATA_QUALITY_SCORING=false
ROLLOUT_DATA_QUALITY_SCORING=0  # 0-100% gradual rollout

# Week 2: Analytics & Storage
USE_DUCKDB_ANALYTICS=false  # Optional: DuckDB for fast analytical queries
ROLLOUT_DUCKDB_ANALYTICS=0

USE_ENHANCED_DEDUPLICATION=false
ROLLOUT_ENHANCED_DEDUPLICATION=0

USE_PRICE_VARIATION_TRACKING=false
ROLLOUT_PRICE_VARIATION_TRACKING=0

# Week 3: Advanced Features
USE_OUTLIER_DETECTION=false
ROLLOUT_OUTLIER_DETECTION=0

USE_SHADOW_MODE_TESTING=false  # Run new code alongside old, log differences
# No rollout % for shadow mode - always 100% when enabled (logging only)

USE_DATA_QUALITY_DASHBOARD=false  # API endpoint for data quality metrics

# Performance Optimizations
USE_AGGRESSIVE_CACHING=false
ROLLOUT_AGGRESSIVE_CACHING=0

USE_BATCH_PROCESSING=false
ROLLOUT_BATCH_PROCESSING=0

# Data Quality Configuration
DATA_QUALITY_MIN_SCORE=0.5  # Minimum quality score (0-1) to accept records
DATA_QUALITY_STRICT_MODE=false  # Throw on validation errors vs warn

# ============================================================================
# QDRANT VECTOR DATABASE (Phase 1 - Technology Upgrade)
# ============================================================================
# Replaces FAISS for production vector search
# Get free 1GB at: https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Required for Qdrant Cloud
QDRANT_COLLECTION=pokemon_cards

# ============================================================================
# REDPANDA/KAFKA EVENT STREAMING (Phase 5 - Technology Upgrade)
# ============================================================================
# Kafka-compatible event streaming for real-time data
# Use Redpanda Cloud or self-hosted
REDPANDA_BROKER=localhost:9092
KAFKA_CLIENT_ID=pokedao
KAFKA_GROUP_ID=pokedao-agent

# ============================================================================
# OPENAI (For CrewAI Multi-Agent - Phase 6)
# ============================================================================
# Required for CrewAI multi-agent system
OPENAI_API_KEY=  # Get from https://platform.openai.com
