generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// CORE ENTITIES
// ===========================================

model Card {
  id              String   @id @default(cuid())

  // Identity (canonical)
  name            String   // Display name
  set             String   // Set name (legacy field)
  number          String   // Card number
  variant         String?  // Holo, 1st Edition, Shadowless
  grade           String?  // PSA 10, CGC 9.5, etc.
  condition       String?  // Near Mint, Played, etc.
  language        String   @default("EN")

  // Normalized fields
  cardKey         String?  // Normalized grouping key for price aggregation
  searchName      String?  // lowercase, no special chars
  searchSet       String?

  // External IDs (for matching across sources)
  priceChartingId String?
  tcgPlayerId     String?
  psaCertNumber   String?
  tcgdexId        String?   // TCGdex canonical ID (e.g., "base1-4")

  // TCGdex enrichment
  rarity          String?   // "Rare", "Common", "Secret Rare"
  category        String?   // "Pokemon", "Trainer", "Energy"
  illustrator     String?
  pokemonTypes    String[]  // ["Fire", "Water"]
  stage           String?   // "Basic", "Stage1", "Stage2"
  imageUrl        String?

  // Tracking
  tracked         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  listings        Listing[]
  evaluations     Evaluation[]
  watchlistItems  WatchlistItem[]
  catalogItems    SourceCatalogItem[]
  priceCache      PriceCache[]
  modelInsights   ModelInsight[]
  priceSnapshots  PriceSnapshot[]
  signalSnapshots SignalSnapshot[]
  dailyStats      DailyCardStats[]
  opportunities   Opportunity[]
  psaPopulation   PsaPopulation?

  @@unique([set, number, variant, grade])
  @@index([cardKey])
  @@index([searchName, searchSet])
  @@index([tracked])
  @@index([tcgdexId])
}

model User {
  id              String   @id @default(cuid())

  // Identity (legacy)
  telegramId      String?  @unique
  discordId       String?  @unique
  username        String?
  firstName       String?
  lastName        String?

  // Multi-platform identity
  platform        String?  // TELEGRAM, DISCORD, WEB
  platformUserId  String?  // Platform-specific user ID

  // Profile
  referralCode    String   @unique
  referredBy      String?
  walletAddress   String?  // Solana wallet address
  tier            String   @default("FREE") // FREE, BASIC, PREMIUM

  // Preferences (denormalized for fast access)
  preferencesJson Json     @default("{}")

  // Stats
  totalAlerts     Int      @default(0)
  totalBought     Int      @default(0)
  totalPassed     Int      @default(0)
  totalProfit     Float    @default(0)

  // Tracking
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())

  // Relations
  purchases       Purchase[]
  referrals       User[]          @relation("UserReferrals")
  referrer        User?           @relation("UserReferrals", fields: [referredBy], references: [referralCode])
  referralEvents  ReferralEvent[]
  watchlistItems  WatchlistItem[]
  portfolio       Portfolio?
  preferences     UserPreferences?
  queries         UserQuery[]
  actions         UserAction[]
  outcomes        UserOutcome[]
  portfolioHoldings PortfolioHolding[]
  alerts          AlertDelivery[]

  @@index([tier])
  @@index([lastActiveAt])
}

// ===========================================
// PRICE DATA COLLECTION
// ===========================================

model PriceSnapshot {
  id              String   @id @default(cuid())

  // Card reference
  cardId          String?
  card            Card?    @relation(fields: [cardId], references: [id])
  cardKey         String?  // For matching before card link

  // Source info
  source          String   // EBAY, MAGIC_EDEN, COURTYARD, etc.
  sourceVersion   String   @default("v1") // Track parser version
  externalId      String?  // Listing ID from source

  // Price data
  price           Float    // Original price
  currency        String   // USD, SOL, ETH, etc.
  priceUsd        Float    // Normalized to USD at time of collection
  fxRate          Float?   // Exchange rate used

  // Item details
  grade           String?  // PSA 10, CGC 9.5, BGS 10, RAW
  grader          String?  // PSA, CGC, BGS, null for raw
  gradeNumeric    Float?   // 10, 9.5, etc. for sorting
  condition       String?  // Near Mint, Lightly Played, etc.

  // Listing metadata
  listingType     String?  // AUCTION, BUY_NOW, OFFER
  sellerId        String?
  sellerRating    Float?
  sellerSales     Int?

  // Timing
  listedAt        DateTime?
  soldAt          DateTime?
  expiresAt       DateTime?

  // Media
  imageUrls       String[] // All images
  thumbnailUrl    String?

  // Location
  country         String?
  shipping        Float?   // Shipping cost

  // Full raw response (NEVER lose data)
  raw             Json?    // Store complete API response
  rawHash         String?  // Hash of raw for dedup

  // Collection metadata
  collectedAt     DateTime @default(now())
  parsedAt        DateTime @default(now())
  parserVersion   String   @default("1.0.0")

  @@unique([source, externalId])
  @@index([cardId, source, collectedAt])
  @@index([cardKey, collectedAt])
  @@index([source, collectedAt])
  @@index([soldAt])
  @@index([priceUsd])
  @@index([grade, gradeNumeric])
  @@index([rawHash])
}

model Listing {
  id              String   @id @default(cuid())

  // Card reference
  cardId          String?
  card            Card?    @relation(fields: [cardId], references: [id])

  // Raw card info (before matching)
  rawCardName     String?
  rawSetName      String?
  rawGrade        String?

  // Source
  source          String
  sourceItemId    String?  // External ID from source
  url             String

  // Price
  price           Float
  currency        String   @default("USD")
  priceUsd        Float?

  // Legacy fields
  seller          String?
  isActive        Boolean  @default(true)
  condition       String?
  raw             Json?
  scrapedAt       DateTime @default(now())

  // New tracking fields
  active          Boolean  @default(true)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  soldAt          DateTime?
  delistedAt      DateTime?

  // Processing
  matchConfidence Float?   // How confident card match is
  processedAt     DateTime?

  // Relations
  evaluations     Evaluation[]
  opportunities   Opportunity[]

  @@unique([source, sourceItemId], name: "source_sourceItemId")
  @@index([cardId, active])
  @@index([source, active])
  @@index([source, scrapedAt])
  @@index([sourceItemId])
  @@index([isActive, scrapedAt])
  @@index([priceUsd])
  @@index([firstSeenAt])
}

// ===========================================
// SIGNAL & ANALYSIS COLLECTION
// ===========================================

model SignalSnapshot {
  id              String   @id @default(cuid())

  // Card reference
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id])
  cardKey         String?

  // Fair value calculation
  fairValue       Float
  fairValueMethod String   // MEDIAN_10, WEIGHTED_AVG, etc.
  confidence      Float    // 0-1
  sampleSize      Int      // How many sales used

  // Trend analysis
  trendDirection  String   // UP, DOWN, STABLE
  trendPercent    Float    // % change
  trendPeriodDays Int      // Period analyzed

  // Price distribution
  priceMin        Float?
  priceMax        Float?
  priceMedian     Float?
  priceStdDev     Float?

  // Liquidity metrics
  liquidityScore  Float    // 0-10
  activeListings  Int
  salesLast7d     Int
  salesLast30d    Int
  avgDaysOnMarket Float?

  // Sentiment metrics
  sentimentScore  Float    // -1 to 1
  sentimentLabel  String   // BULLISH, BEARISH, NEUTRAL
  mentionCount7d  Int      @default(0)

  // Scarcity metrics
  psa10Pop        Int?
  psa9Pop         Int?
  totalPop        Int?
  scarcityScore   Float?   // 0-10

  // Arbitrage opportunities
  arbitrageCount  Int      @default(0)
  bestArbitrage   Json?    // { buySource, sellSource, margin }

  // Full signal object
  signals         Json     // Complete signal calculation

  // Metadata
  calculatedAt    DateTime @default(now())
  calculationMs   Int?     // How long calculation took
  version         String   @default("1.0.0")

  @@index([cardId, calculatedAt])
  @@index([cardKey, calculatedAt])
  @@index([calculatedAt])
  @@index([fairValue])
  @@index([liquidityScore])
}

model Opportunity {
  id              String   @id @default(cuid())

  // References
  cardId          String?
  card            Card?    @relation(fields: [cardId], references: [id])
  listingId       String
  listing         Listing  @relation(fields: [listingId], references: [id])
  signalSnapshotId String?

  // Card info (denormalized)
  cardKey         String?
  cardName        String
  setName         String?
  grade           String?

  // Opportunity details
  listingPrice    Float
  fairValue       Float
  discount        Float    // Percentage below fair value

  // Thesis
  thesis          String   @db.Text
  thesisType      String?  // TEMPLATE, LLM
  recommendation  String   // STRONG_BUY, BUY, WATCH, PASS

  // Signals at time of opportunity (denormalized for ML)
  signals         Json?

  // Source
  source          String
  url             String

  // Status
  status          String   @default("PENDING") // PENDING, ALERTED, BOUGHT, PASSED, EXPIRED
  usedLLM         Boolean  @default(false)

  // Outcome tracking (filled in later)
  wasAlerted      Boolean  @default(false)
  alertedAt       DateTime?
  wasActedOn      Boolean  @default(false)
  userAction      String?  // BOUGHT, PASSED, IGNORED
  actionAt        DateTime?

  // If bought, track outcome
  purchasePrice   Float?
  currentValue    Float?
  actualReturn    Float?   // Percentage
  returnUpdatedAt DateTime?

  // Metadata
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  // Relations
  thesisRecord    ThesisRecord?
  userActions     UserAction[]
  alerts          AlertDelivery[]

  @@index([cardId, createdAt])
  @@index([cardKey, createdAt])
  @@index([status, createdAt])
  @@index([recommendation])
  @@index([discount])
}

model ThesisRecord {
  id              String   @id @default(cuid())

  // Reference
  opportunityId   String   @unique
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  cardId          String?
  cardKey         String?

  // Generation details
  thesisType      String   // TEMPLATE, LLM
  templateName    String?  // Which template used
  model           String?  // groq/llama-3.1-8b, etc.

  // Input (for reproducibility)
  promptTemplate  String?  @db.Text
  promptVariables Json?
  signalsInput    Json     // Signals used to generate

  // Output
  thesis          String   @db.Text
  recommendation  String
  confidence      Float?

  // Performance
  generationMs    Int
  inputTokens     Int?
  outputTokens    Int?
  cost            Float?   // LLM cost in USD

  // Outcome tracking
  wasActedOn      Boolean  @default(false)
  userAction      String?
  actualReturn    Float?   // If user bought

  // Quality metrics (filled in later)
  userRating      Int?     // 1-5 stars
  wasAccurate     Boolean? // Did prediction match reality

  createdAt       DateTime @default(now())

  @@index([cardId, createdAt])
  @@index([cardKey, createdAt])
  @@index([thesisType])
  @@index([recommendation])
  @@index([wasActedOn, actualReturn])
}

// ===========================================
// USER ACTIVITY COLLECTION
// ===========================================

model UserQuery {
  id              String   @id @default(cuid())

  // User reference
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  // Query details
  platform        String   // TELEGRAM, DISCORD, WEB, API
  sessionId       String?  // Group related queries

  // Raw input
  rawText         String   @db.Text

  // Parsed intent
  intentType      String   // SEARCH, PRICE, PORTFOLIO, SUBSCRIBE, HELP, OTHER
  intentConfidence Float?

  // Extracted entities
  entities        Json     // { cardName, set, grade, maxPrice, etc. }

  // Response
  responseType    String?  // CARD_LIST, PRICE_INFO, ERROR, etc.
  responseLength  Int?
  resultsCount    Int?

  // Performance
  responseTimeMs  Int

  // Context
  conversationId  String?  // For multi-turn conversations
  previousQueryId String?  // Link to previous query in conversation

  // Raw messages (for debugging)
  rawRequest      Json?
  rawResponse     Json?

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([platform, createdAt])
  @@index([intentType])
  @@index([sessionId])
}

model UserAction {
  id              String   @id @default(cuid())

  // References
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  queryId         String?  // Which query led to this action

  // Action details
  action          String   // VIEWED, CLICKED, BOUGHT, PASSED, IGNORED, WATCHLIST_ADD, etc.
  platform        String

  // Context
  source          String?  // ALERT, SEARCH, DASHBOARD, etc.
  position        Int?     // Position in list if from search results

  // Timing
  timeToActionMs  Int?     // Time from alert/view to action

  // Metadata
  metadata        Json?    // Any additional context

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([opportunityId])
  @@index([action, createdAt])
}

model UserOutcome {
  id              String   @id @default(cuid())

  // References
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  opportunityId   String?
  cardId          String?
  cardKey         String?

  // Purchase details
  purchasePrice   Float
  purchaseDate    DateTime
  purchaseSource  String?  // Where they bought
  grade           String?

  // Thesis at time of purchase (denormalized)
  thesisAtPurchase String?  @db.Text
  fairValueAtPurchase Float?
  discountAtPurchase Float?

  // Current tracking
  currentValue    Float?
  lastValueUpdate DateTime?

  // Sale details (if sold)
  soldPrice       Float?
  soldDate        DateTime?
  soldSource      String?

  // Calculated returns
  unrealizedReturn Float?  // Current value - purchase price
  unrealizedReturnPct Float?
  realizedReturn  Float?   // If sold
  realizedReturnPct Float?

  // Holding period
  holdingDays     Int?

  // Status
  status          String   @default("HOLDING") // HOLDING, SOLD, LOST, UNKNOWN

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([cardId])
  @@index([cardKey])
  @@index([purchaseDate])
  @@index([realizedReturnPct])
}

model PortfolioHolding {
  id              String   @id @default(cuid())

  // Legacy relation
  portfolioId     String?
  portfolio       Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  // Direct user relation
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])

  cardId          String?
  cardKey         String?
  cardName        String?
  setName         String?
  grade           String?

  // Holding details
  quantity        Int      @default(1)
  costBasisCents  Int?     // Legacy field
  purchasePrice   Float?
  purchaseDate    DateTime @default(now())
  purchaseVenue   String?  // Where bought
  notes           String?

  // Current value
  currentValue    Float?
  lastUpdated     DateTime?

  // Alerts
  targetSellPrice Float?
  stopLossPrice   Float?

  // Sale tracking
  soldAt          DateTime?
  soldPriceCents  Int?     // Legacy
  soldPrice       Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portfolioId, cardKey])
  @@index([userId])
  @@index([cardId])
  @@index([cardKey])
}

model AlertDelivery {
  id              String   @id @default(cuid())

  // References
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])

  // Delivery details
  platform        String   // TELEGRAM, DISCORD, etc.
  channel         String?  // DM, group, etc.
  messageId       String?  // Platform message ID

  // Content
  thesis          String?  @db.Text
  formattedMessage String? @db.Text

  // Status
  status          String   // QUEUED, SENT, DELIVERED, READ, FAILED
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failureReason   String?

  // User response
  responseAction  String?  // BOUGHT, PASSED, etc.
  responseAt      DateTime?
  responseTimeMs  Int?     // Time from delivery to response

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([opportunityId])
  @@index([status])
}

// ===========================================
// SOCIAL & NEWS COLLECTION
// ===========================================

model SocialPost {
  id              String   @id @default(cuid())

  // Source
  platform        String   // REDDIT, TWITTER, YOUTUBE, DISCORD
  externalId      String
  url             String

  // Author
  authorId        String?
  authorUsername  String?
  authorFollowers Int?
  isInfluencer    Boolean  @default(false)

  // Content
  title           String?
  body            String   @db.Text
  contentType     String   // POST, COMMENT, TWEET, VIDEO

  // Engagement
  upvotes         Int?
  downvotes       Int?
  likes           Int?
  retweets        Int?
  comments        Int?
  views           Int?
  engagementScore Float?   // Normalized 0-100

  // Analysis
  sentiment       Float    // -1 to 1
  sentimentLabel  String   // BULLISH, BEARISH, NEUTRAL
  sentimentModel  String?  // Which model/method used

  // Card mentions
  mentionedCards  String[] // Card names detected
  mentionedSets   String[] // Set names detected

  // Topics
  topics          String[] // PRICE, INVESTMENT, GRADING, FAKE, etc.

  // Media
  hasImage        Boolean  @default(false)
  hasVideo        Boolean  @default(false)
  imageUrls       String[]

  // Timing
  postedAt        DateTime
  collectedAt     DateTime @default(now())

  // Raw
  raw             Json?

  @@unique([platform, externalId])
  @@index([platform, postedAt])
  @@index([mentionedCards])
  @@index([sentiment])
  @@index([isInfluencer])
}

// Legacy Reddit model (kept for backwards compatibility)
model RedditPost {
  id             String   @id @default(cuid())
  redditId       String   @unique
  subreddit      String
  title          String
  body           String   @db.Text
  score          Int
  numComments    Int
  url            String
  sentiment      Float    // -1 to 1
  sentimentLabel String   // BULLISH, BEARISH, NEUTRAL
  mentionedCards String[] // Card names mentioned
  createdAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([subreddit, createdAt])
  @@index([sentimentLabel])
}

model NewsEvent {
  id              String   @id @default(cuid())

  // Event type
  type            String   // SET_RELEASE, REPRINT, BAN, TOURNAMENT, COMPANY_NEWS, etc.
  subtype         String?  // More specific categorization

  // Content
  title           String
  description     String?  @db.Text
  summary         String?  @db.Text // AI-generated summary

  // Source
  source          String   // POKEMON_COMPANY, WOTC, NEWS_SITE, etc.
  sourceUrl       String?

  // Impact analysis
  affectedCards   String[] // Card IDs
  affectedSets    String[] // Set names
  expectedImpact  String?  // POSITIVE, NEGATIVE, NEUTRAL
  impactScore     Float?   // -10 to 10

  // Actual impact (filled in later)
  actualPriceImpact Float? // Average % change in affected cards
  actualPriceImpactMeasuredAt DateTime?

  // Timing
  eventDate       DateTime
  announcedAt     DateTime?
  collectedAt     DateTime @default(now())

  // Raw
  raw             Json?

  @@index([type, eventDate])
  @@index([affectedCards])
  @@index([eventDate])
}

// ===========================================
// GRADING DATA
// ===========================================

model PsaPopulation {
  id              String   @id @default(cuid())

  cardId          String   @unique
  card            Card     @relation(fields: [cardId], references: [id])
  cardKey         String?

  // Population by grade
  gem10           Int?     // PSA 10
  mint9           Int?     // PSA 9
  nmMt8           Int?
  nm7             Int?
  exMt6           Int?
  ex5             Int?
  vgEx4           Int?
  vg3             Int?
  good2           Int?
  fair1           Int?
  authentic       Int?     // Authentic (no grade)

  totalPop        Int

  // Historical tracking
  previousPop     Json?    // { date, gem10, mint9, ... }
  popChange30d    Json?    // Change in last 30 days

  // Source
  psaSetId        String?
  psaCertLookupUrl String?

  fetchedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cardKey])
  @@index([totalPop])
  @@index([gem10])
}

// ===========================================
// AGGREGATED STATS (for fast queries)
// ===========================================

model DailyCardStats {
  id              String   @id @default(cuid())

  date            DateTime @db.Date
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id])
  cardKey         String?

  // Price stats
  avgPrice        Float
  minPrice        Float
  maxPrice        Float
  medianPrice     Float
  priceStdDev     Float?

  // Change from previous day
  priceChangeAbs  Float?
  priceChangePct  Float?

  // Volume
  salesCount      Int
  listingsCount   Int
  newListings     Int?
  soldListings    Int?
  volumeUsd       Float

  // By source
  salesBySource   Json?    // { EBAY: 10, MAGIC_EDEN: 5, ... }
  volumeBySource  Json?

  // Sentiment
  sentimentAvg    Float?
  mentionCount    Int?

  // Signals summary
  fairValue       Float?
  liquidityScore  Float?

  createdAt       DateTime @default(now())

  @@unique([date, cardId])
  @@index([date])
  @@index([cardId])
  @@index([cardKey])
}

model DailyMarketStats {
  id              String   @id @default(cuid())

  date            DateTime @db.Date @unique

  // Overall market
  totalCards      Int
  trackedCards    Int
  totalListings   Int
  totalSales      Int
  totalVolumeUsd  Float

  // Price trends
  avgPriceChange  Float?   // Average % change across all cards
  cardsUp         Int?     // Cards with positive change
  cardsDown       Int?     // Cards with negative change
  cardsStable     Int?

  // Top movers
  topGainers      Json     // [{ cardId, name, changePct }]
  topLosers       Json
  mostVolume      Json
  mostActive      Json     // Most sales

  // By source
  volumeBySource  Json     // { EBAY: 100000, MAGIC_EDEN: 50000, ... }
  salesBySource   Json

  // Sentiment
  overallSentiment Float?
  sentimentLabel  String?
  socialMentions  Int?

  // Opportunities
  opportunitiesFound Int?
  avgDiscount     Float?

  createdAt       DateTime @default(now())

  @@index([date])
}

model DailySourceStats {
  id              String   @id @default(cuid())

  date            DateTime @db.Date
  source          String

  listingsCollected Int
  salesCollected  Int
  volumeUsd       Float
  uniqueCards     Int
  avgPrice        Float

  // Health metrics
  apiCalls        Int?
  apiErrors       Int?
  avgLatencyMs    Int?

  createdAt       DateTime @default(now())

  @@unique([date, source])
  @@index([date])
  @@index([source])
}

// ===========================================
// ML TRAINING DATA EXPORT
// ===========================================

model MLTrainingExample {
  id              String   @id @default(cuid())

  // Type
  taskType        String   // PRICE_PREDICTION, BUY_SIGNAL, SENTIMENT, etc.

  // Input features (flattened for ML)
  features        Json     // All input features

  // Target/label
  label           String?  // For classification
  target          Float?   // For regression

  // Source references
  cardId          String?
  cardKey         String?
  opportunityId   String?
  thesisRecordId  String?

  // Quality
  isVerified      Boolean  @default(false) // Human verified
  confidenceScore Float?

  // Timing
  featureDate     DateTime // When features were captured
  labelDate       DateTime? // When outcome was known

  createdAt       DateTime @default(now())

  @@index([taskType])
  @@index([isVerified])
  @@index([featureDate])
  @@index([cardKey])
}

// ===========================================
// LEGACY MODELS (kept for backwards compatibility)
// ===========================================

model Evaluation {
  id               String   @id @default(cuid())
  cardId           String
  listingId        String
  fairValue        Float
  discount         Float
  investmentThesis String
  riskLevel        String
  projectedReturn  Float?
  confidence       Float
  createdAt        DateTime @default(now())

  card    Card    @relation(fields: [cardId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  amount    Float
  fee       Float
  status    String
  txHash    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Comp {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralEvent {
  id        String   @id @default(cuid())
  userId    String
  code      String
  path      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])
}

model SourceCatalogItem {
  id           String   @id @default(cuid())
  source       String
  sourceItemId String
  title        String
  setName      String?
  number       String?
  grade        String?
  url          String
  cardKey      String?
  cardId       String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  card         Card?         @relation(fields: [cardId], references: [id])
  insights     ModelInsight[] @relation("CatalogInsights")

  @@unique([source, sourceItemId])
  @@index([cardKey])
  @@index([source, lastSeenAt])
  @@index([cardId])
}

model PriceCache {
  id          String   @id @default(cuid())
  cardKey     String
  cardId      String?
  windowDays  Int
  median      Decimal  @db.Decimal(10,2)
  iqr         Decimal  @db.Decimal(10,2)
  sampleSize  Int
  updatedAt   DateTime @default(now())

  card        Card?    @relation(fields: [cardId], references: [id])

  @@unique([cardKey, windowDays])
  @@index([cardKey])
  @@index([cardId])
}

model ModelInsight {
  id               String   @id @default(cuid())
  cardKey          String?
  cardId           String?
  catalogItemId    String?
  verdict          String
  fairValue        Decimal? @db.Decimal(10,2)
  confidence       Float
  risks            String[]
  rationale        String?
  inputHash        String
  model            String   @default("deepseek")
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  card             Card?              @relation(fields: [cardId], references: [id])
  catalogItem      SourceCatalogItem? @relation("CatalogInsights", fields: [catalogItemId], references: [id])

  @@unique([inputHash])
  @@index([cardKey, createdAt])
  @@index([verdict, expiresAt])
  @@index([cardId])
  @@index([catalogItemId])
}

model ScrapeCursor {
  id        String   @id @default(cuid())
  source    String   @unique
  cursor    String
  updatedAt DateTime @default(now())
}

model RateBudget {
  id            String   @id @default(cuid())
  source        String   @unique
  maxPerWindow  Int
  windowSec     Int
  lastResetAt   DateTime @default(now())
  usedCount     Int      @default(0)

  @@index([source, lastResetAt])
}

model PriceHistory {
  id        String   @id @default(cuid())
  cardKey   String
  cardId    String?
  source    String
  priceCents Int
  soldAt    DateTime
  condition String?
  grade     String?
  url       String?
  createdAt DateTime @default(now())

  @@index([cardKey, soldAt])
  @@index([cardId, soldAt])
  @@index([source, soldAt])
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("Default Portfolio")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  holdings  PortfolioHolding[]
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  alertsEnabled      Boolean  @default(true)
  minSpreadPct       Float    @default(15.0)
  minPriceCents      Int      @default(500)
  maxPriceCents      Int      @default(100000)
  alertGrades        String[] @default(["PSA 10", "PSA 9", "BGS 9.5", "CGC 10"])
  alertSources       String[] @default(["eBay", "JustTCG", "Phygitals"])
  maxAlertsPerHour   Int      @default(10)
  quietHoursStart    String?
  quietHoursEnd      String?
  minDiscountPct     Float    @default(10.0)
  minPriceUsd        Float    @default(0)
  maxPriceUsd        Float    @default(10000)
  grades             String[] @default(["PSA 10", "PSA 9", "CGC 10", "BGS 10"])
  snoozedCards       Json     @default("{}")
  snoozedUntil       DateTime?
  tokenGateEnabled   Boolean  @default(false)
  minTokenBalance    Int      @default(0)
  currency           String   @default("USD")
  timezone           String   @default("UTC")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id])
}

model MarketCommentary {
  id           String   @id @default(cuid())
  type         String
  title        String
  content      String
  highlights   String[]
  topCards     String[]
  sentiment    String?
  model        String   @default("deepseek")
  publishedAt  DateTime?
  xPostId      String?
  telegramMsgId String?
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
  @@index([publishedAt])
}

// ===========================================
// SMART CONTRACT VULNERABILITY SCANNER
// ===========================================

model SmartContract {
  id              String   @id @default(cuid())

  // Identity
  address         String
  chainId         Int
  chainName       String   // Ethereum, Base, Arbitrum, etc.
  name            String?  // Contract name from Etherscan
  compilerVersion String?

  // Source
  sourceCode      String?  @db.Text
  abi             Json?
  isProxy         Boolean  @default(false)
  implementationAddress String?

  // Protocol context (from DeFiLlama)
  protocolName    String?
  protocolSlug    String?
  tvlUsd          Float?   // Total value locked at scan time
  category        String?  // DEX, Lending, Bridge, etc.

  // Status
  verified        Boolean  @default(false)
  lastScannedAt   DateTime?

  // Tracking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  scans           ContractScan[]

  @@unique([address, chainId])
  @@index([chainId])
  @@index([protocolName])
  @@index([tvlUsd])
  @@index([lastScannedAt])
}

model ContractScan {
  id              String   @id @default(cuid())

  // Contract reference
  contractId      String
  contract        SmartContract @relation(fields: [contractId], references: [id])

  // Scan config
  scanType        String   // FULL, QUICK, DEEP
  toolsUsed       String[] // ["slither", "aderyn", "semgrep", "ai"]

  // Results
  status          String   // PENDING, RUNNING, COMPLETED, FAILED
  findingsCount   Int      @default(0)
  criticalCount   Int      @default(0)
  highCount       Int      @default(0)
  mediumCount     Int      @default(0)
  lowCount        Int      @default(0)
  infoCount       Int      @default(0)

  // Performance
  durationMs      Int?
  errorMessage    String?  @db.Text

  // Raw outputs
  slitherOutput   Json?
  aiAnalysis      Json?

  // Tracking
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  // Relations
  findings        ScanFinding[]
  alerts          ScanAlert[]

  @@index([contractId, startedAt])
  @@index([status])
  @@index([startedAt])
}

model ScanFinding {
  id              String   @id @default(cuid())

  // Scan reference
  scanId          String
  scan            ContractScan @relation(fields: [scanId], references: [id])

  // Finding details
  detector        String   // slither check name or AI detector
  tool            String   // slither, aderyn, semgrep, ai
  severity        String   // CRITICAL, HIGH, MEDIUM, LOW, INFORMATIONAL
  confidence      String   // HIGH, MEDIUM, LOW

  // Description
  title           String
  description     String   @db.Text

  // Code location
  filePath        String?
  lineNumbers     Int[]
  codeSnippet     String?  @db.Text

  // AI enrichment
  aiAssessment    String?  // TRUE_POSITIVE, FALSE_POSITIVE, NEEDS_REVIEW
  attackPath      String?  @db.Text
  recommendation  String?  @db.Text
  exploitability  String?  // EXPLOITABLE, THEORETICAL, UNLIKELY

  // Deduplication
  findingHash     String   // Hash of detector+severity+location for dedup

  // Tracking
  createdAt       DateTime @default(now())

  @@unique([scanId, findingHash])
  @@index([scanId])
  @@index([severity])
  @@index([detector])
  @@index([tool])
}

model ScanAlert {
  id              String   @id @default(cuid())

  // Scan reference
  scanId          String
  scan            ContractScan @relation(fields: [scanId], references: [id])

  // Delivery
  platform        String   // TELEGRAM, CLAWDBOT
  chatId          String?
  messageId       String?

  // Content
  severity        String   // Overall severity of the alert
  summary         String   @db.Text
  findingsCount   Int

  // Status
  status          String   // QUEUED, SENT, DELIVERED, FAILED
  sentAt          DateTime?
  failureReason   String?

  createdAt       DateTime @default(now())

  @@index([scanId])
  @@index([status])
  @@index([platform, sentAt])
}
