{
  "name": "pokedao",
  "private": true,
  "version": "0.0.0",
  "description": "PokeDAO monorepo",
  "workspaces": [
    "api",
    "bot",
    "worker",
    "ml",
    "packages/shared",
    "apps/agent"
  ],
  "scripts": {
    "preflight": "ts-node scripts/preflight.ts",
    "build": "pnpm run preflight && pnpm -r run build",
    "api:dev": "pnpm --filter @pokedao/api dev",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "green:verify": "cd api && npx prisma validate && npx prisma generate && cd .. && pnpm run preflight && pnpm -w typecheck && pnpm -w build",
    "build:scripts": "tsc -p ./scripts/tsconfig.json",
    "setup": "pnpm install && pnpm --filter api prisma generate && pnpm run db:reset",
    "db:reset": "pnpm --filter api prisma migrate reset --force && pnpm run db:seed",
    "db:seed": "pnpm --filter api prisma db seed",
    "test": "pnpm -r run test",
    "seed:minimal": "tsx scripts/seed-minimal.ts",
    "seed:oppty": "tsx scripts/seed-oppty.ts",
    "seed:from-listing": "tsx scripts/seed-from-listing.ts",
    "seed:mini": "pnpm --filter @pokedao/agent exec tsx scripts/seed-minimal.ts",
    "seed-and-tick": "pnpm -s seed:from-listing && OPP_MIN_NET_SPREAD_BPS=0 OPP_MIN_30D_SALES=0 AGENT_SMOKE_ONLY=false pnpm -s agent:tick",
    "test:smoke": "AGENT_DEBUG=true OPP_MIN_NET_SPREAD_BPS=0 OPP_MIN_30D_SALES=0 AGENT_SMOKE_ONLY=false tsx scripts/verify-opportunity.ts",
    "smoke": "node scripts/smoke.sh",
    "pipeline:relaxed": "pnpm dlx tsx scripts/run-featurizer.ts && pnpm dlx tsx scripts/run-scorer.ts && THESIS_RELAXED=1 pnpm dlx tsx scripts/run-thesis.ts",
    "pipeline:strict": "pnpm dlx tsx scripts/run-featurizer.ts && pnpm dlx tsx scripts/run-scorer.ts && THESIS_RELAXED=0 THESIS_MIN_COMPS_90=5 THESIS_MAX_VOL_BP=1200 THESIS_MAX_FRESH_DAYS=14 pnpm dlx tsx scripts/run-thesis.ts",
    "collect:sold:ebay": "tsx scripts/collect-ebay-sold.ts",
    "export:ebay:extended": "tsx scripts/export-ebay-extended.ts",
    "ingest:ebay:extended": "tsx scripts/ingest-ebay-extended.ts data/research/ebay_current_extended.json",
    "export:tcg:anchors": "tsx scripts/export-tcgplayer-anchors.ts",
    "ingest:pricecache": "tsx scripts/ingest-pricecache.ts data/research/tcgplayer_anchors.json tcgplayer",
    "titles:run": "tsx scripts/run-title-parser.ts",
    "titles:backfill": "tsx scripts/backfill-title-cache.ts",
    "export:cm:anchors": "tsx scripts/export-cardmarket-anchors.ts",
    "ingest:cm:anchors": "tsx scripts/ingest-pricecache.ts data/research/cardmarket_anchors.json cardmarket",
    "export:tcg:cards": "tsx scripts/export-tcg-catalog-cards.ts",
    "ingest:cards": "tsx scripts/ingest-catalog-cards.ts data/research/tcg_catalog_cards.json",
    "export:cc:comps": "tsx scripts/export-collector-crypt-comps.ts",
    "ingest:cc:comps": "pnpm dlx tsx scripts/load-thin-json.ts --comps data/research/comps_collectorcrypt.json --source CollectorCrypt --limit 200000",
    "pipeline:live": "pnpm run collect:sold:ebay && tsx scripts/run-featurizer.ts && tsx scripts/run-scorer.ts && pnpm run pipeline:strict",
    "cardmarket:test": "node cardmarket-pokemon-extractor.js --test",
    "market:pipeline": "bash apps/agent/scripts/run-market-pipeline.sh",
    "market:pipeline:conservative": "bash apps/agent/scripts/run-market-pipeline.sh --mode=conservative",
    "market:pipeline:aggressive": "bash apps/agent/scripts/run-market-pipeline.sh --mode=aggressive",
    "market:ebay": "bash apps/agent/scripts/run-market-pipeline.sh --sources=ebay",
    "market:tcg": "bash apps/agent/scripts/run-market-pipeline.sh --sources=tcgplayer",
    "market:fanatics": "bash apps/agent/scripts/run-market-pipeline.sh --sources=fanatics",
    "market:collector": "bash apps/agent/scripts/run-market-pipeline.sh --sources=collectorcrypt",
    "market:all": "bash apps/agent/scripts/run-market-pipeline.sh --sources=ebay,tcgplayer,fanatics,collectorcrypt",
    "market:collections:slabs": "bash apps/agent/scripts/run-market-pipeline.sh --collections=slabs",
    "market:collections:prospects": "bash apps/agent/scripts/run-market-pipeline.sh --collections=prospects",
    "market:collections:watchlist": "bash apps/agent/scripts/run-market-pipeline.sh --collections=watchlist",
    "market:dry-run": "bash apps/agent/scripts/run-market-pipeline.sh --dry-run",
    "market:verbose": "bash apps/agent/scripts/run-market-pipeline.sh --verbose",
    "ebay:pipeline": "bash scripts/run-ebay-pipeline.sh",
    "ebay:pipeline:conservative": "bash scripts/run-ebay-pipeline.sh --min-profit 20 --max-risk LOW --min-confidence 0.8",
    "ebay:pipeline:aggressive": "bash scripts/run-ebay-pipeline.sh --min-profit 10 --max-risk HIGH --min-confidence 0.6",
    "ebay:quality": "tsx scripts/ebay-data-quality-assessment.ts",
    "ebay:clean": "tsx scripts/ebay-data-cleaner.ts",
    "ebay:cross-reference": "tsx scripts/ebay-cross-reference-matcher.ts",
    "ebay:arbitrage": "tsx scripts/ebay-arbitrage-detector.ts",
    "cardmarket:extract": "node cardmarket-pokemon-extractor.js",
    "cardmarket:setup": "node test-cardmarket-integration.js",
    "x:dry": "POSTING_ENABLED=false POSTING_DRY_RUN=true tsx scripts/x-dry-run.ts",
    "agent:dev": "pnpm --filter @pokedao/agent dev",
    "agent:tick": "pnpm --filter @pokedao/agent tick",
    "smoke:tick": "tsx scripts/agent-smoke-tick.ts",
    "smoke:daily": "tsx scripts/post-daily-once.ts",
    "smoke:flash": "tsx scripts/flash-direct.ts",
    "data:integrity:overhaul": "tsx scripts/data-integrity-overhaul.ts",
    "data:integrity:check": "tsx scripts/data-integrity-check.ts",
    "data:integrity:validate": "tsx scripts/data-integrity-validate.ts",
    "data:integrity:dedupe": "tsx scripts/data-integrity-dedupe.ts",
    "data:integrity:monitor": "tsx scripts/data-integrity-monitor.ts",
    "crypto:trader": "OPP_MIN_NET_SPREAD_BPS=2500 OPP_MIN_30D_SALES=10 OPP_MIN_CONFIDENCE=0.75 OPP_MIN_CARD_VALUE_CENTS=10000 OPP_MIN_PROFIT_CENTS=10000 FLASH_MIN_SPREAD_BPS=3500 FLASH_MIN_CONFIDENCE=0.85 POST_MIN_EDGE_BP=2000 POST_MIN_CONF=0.70 POST_RATE_LIMIT=1 pnpm run agent:dev"
  },
  "prisma": {
    "schema": "./api/prisma/schema.prisma",
    "seed": "node api/prisma/seed.mjs"
  },
  "devDependencies": {
    "@prisma/client": "6.15.0",
    "@types/node": "^24.3.3",
    "dotenv": "^17.2.2",
    "js-yaml": "^4.1.0",
    "prisma": "6.15.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "yaml": "^2.3.1"
  },
  "pnpm": {
    "overrides": {
      "@prisma/client": "6.15.0",
      "prisma": "6.15.0"
    }
  },
  "dependencies": {
    "cardmarket-wrapper": "^1.0.6",
    "dotenv": "^16.0.0",
    "node-fetch": "^2.6.7",
    "redis": "^5.8.2",
    "twitter-api-v2": "^1.27.0",
    "typescript": "^5.9.2"
  }
}