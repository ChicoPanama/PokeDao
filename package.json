{
  "name": "pokedao",
  "private": true,
  "version": "0.0.0",
  "description": "PokeDAO monorepo",
  "workspaces": [
    "api",
    "bot",
    "worker",
    "ml",
    "packages/shared",
    "packages/core",
    "packages/analysis",
    "packages/storage",
    "packages/adapters",
    "apps/agent"
  ],
  "scripts": {
    "preflight": "ts-node scripts/preflight.ts",
    "build": "pnpm run preflight && pnpm -r run build",
    "api:dev": "pnpm --filter @pokedao/api dev",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "green:verify": "cd api && npx prisma validate && npx prisma generate && cd .. && pnpm run preflight && pnpm -w typecheck && pnpm -w build",
    "build:scripts": "tsc -p ./scripts/tsconfig.json",
    "setup": "pnpm install && pnpm --filter api prisma generate && pnpm run db:reset",
    "db:reset": "pnpm --filter api prisma migrate reset --force && pnpm run db:seed",
    "db:seed": "pnpm --filter api prisma db seed",
    "test": "pnpm -r run test",
    "smoke": "node scripts/smoke.sh",
    "pipeline:relaxed": "pnpm dlx tsx scripts/run-featurizer.ts && pnpm dlx tsx scripts/run-scorer.ts && THESIS_RELAXED=1 pnpm dlx tsx scripts/run-thesis.ts",
    "pipeline:strict": "pnpm dlx tsx scripts/run-featurizer.ts && pnpm dlx tsx scripts/run-scorer.ts && THESIS_RELAXED=0 THESIS_MIN_COMPS_90=5 THESIS_MAX_VOL_BP=1200 THESIS_MAX_FRESH_DAYS=14 pnpm dlx tsx scripts/run-thesis.ts",
    "collect:sold:ebay": "tsx scripts/collect-ebay-sold.ts",
    "export:ebay:extended": "tsx scripts/export-ebay-extended.ts",
    "ingest:ebay:extended": "tsx scripts/ingest-ebay-extended.ts data/research/ebay_current_extended.json",
    "export:tcg:anchors": "tsx scripts/export-tcgplayer-anchors.ts",
    "ingest:pricecache": "tsx scripts/ingest-pricecache.ts data/research/tcgplayer_anchors.json tcgplayer",
    "titles:run": "tsx scripts/run-title-parser.ts",
    "titles:backfill": "tsx scripts/backfill-title-cache.ts",
    "export:cm:anchors": "tsx scripts/export-cardmarket-anchors.ts",
    "ingest:cm:anchors": "tsx scripts/ingest-pricecache.ts data/research/cardmarket_anchors.json cardmarket",
    "export:tcg:cards": "tsx scripts/export-tcg-catalog-cards.ts",
    "ingest:cards": "tsx scripts/ingest-catalog-cards.ts data/research/tcg_catalog_cards.json",
    "export:cc:comps": "tsx scripts/export-collector-crypt-comps.ts",
    "ingest:cc:comps": "pnpm dlx tsx scripts/load-thin-json.ts --comps data/research/comps_collectorcrypt.json --source CollectorCrypt --limit 200000",
    "pipeline:live": "pnpm run collect:sold:ebay && tsx scripts/run-featurizer.ts && tsx scripts/run-scorer.ts && pnpm run pipeline:strict",
    "cardmarket:test": "node cardmarket-pokemon-extractor.js --test",
    "cardmarket:extract": "node cardmarket-pokemon-extractor.js",
    "cardmarket:setup": "node test-cardmarket-integration.js",
    "x:dry": "POSTING_ENABLED=false POSTING_DRY_RUN=true tsx scripts/x-dry-run.ts",
    "agent:dev": "pnpm --filter @pokedao/agent dev",
    "agent:tick": "pnpm --filter @pokedao/agent tick",
    "smoke:tick": "tsx scripts/agent-smoke-tick.ts",
    "smoke:daily": "tsx scripts/post-daily-once.ts",
    "smoke:flash": "tsx scripts/flash-direct.ts",
    "collect:justtcg": "tsx scripts/collect-justtcg.ts",
    "data:ingest:bronze": "tsx scripts/data/ingest-bronze.ts",
    "data:build:silver": "tsx scripts/data/build-silver.ts",
    "data:build:gold": "tsx scripts/data/build-gold.ts",
    "data:sync:db": "tsx scripts/data/sync-postgres.ts",
    "data:pipeline": "pnpm data:ingest:bronze && pnpm data:build:silver && pnpm data:build:gold && pnpm data:sync:db"
  },
  "prisma": {
    "schema": "./api/prisma/schema.prisma",
    "seed": "node api/prisma/seed.mjs"
  },
  "devDependencies": {
    "@prisma/client": "^6.15.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/xml2js": "^0.4.14",
    "dotenv": "^17.2.2",
    "prisma": "^6.15.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5"
  },
  "pnpm": {
    "overrides": {
      "@prisma/client": "6.15.0",
      "prisma": "6.15.0"
    }
  },
  "dependencies": {
    "@metaplex-foundation/js": "^0.20.1",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.4.1",
    "cardmarket-wrapper": "^1.0.6",
    "dotenv": "^16.0.0",
    "helius-sdk": "^2.0.2",
    "node-fetch": "^2.6.7",
    "parquetjs": "^0.11.2",
    "redis": "^5.8.2",
    "twitter-api-v2": "^1.27.0",
    "typescript": "^5.9.2",
    "xml2js": "^0.6.2",
    "zod": "^4.1.11"
  }
}
