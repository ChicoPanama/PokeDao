generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// CORE CANONICAL DATA MODELS
// ============================================================================

model CanonicalCard {
  id               String    @id
  officialCardId   String?
  canonicalName    String
  canonicalSet     String
  cardNumber       String?
  variant          String?
  supportedGraders String[]
  aliases          Json?
  rarity           String?
  hp               Int?
  types            String[]
  illustrator      String?
  totalListings    Int       @default(0)
  avgPriceCents    Int?
  dataQuality      Float     @default(0.5)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  officialCard     OfficialPokemonCard? @relation(fields: [officialCardId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  saleRecords      SaleRecord[]
  cardSignals      CardSignal[]
  consensusPricing ConsensusPricing[]
  marketListings   MarketListing[]
  redditSignals    RedditSignal[]

  @@index([canonicalName, canonicalSet])
  @@index([officialCardId])
  @@map("canonical_cards")
}

model OfficialPokemonCard {
  id                  String    @id
  localId             String
  name                String
  setId               String
  setName             String
  rarity              String?
  category            String?
  hp                  Int?
  types               String[]
  stage               String?
  illustrator         String?
  retreat             Int?
  variantFirstEdition Boolean   @default(false)
  variantHolo         Boolean   @default(false)
  variantNormal       Boolean   @default(false)
  variantReverse      Boolean   @default(false)
  variantShadowless   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  canonicalCards CanonicalCard[]

  @@index([name])
  @@index([setId, localId])
  @@map("official_pokemon_cards")
}

// ============================================================================
// MARKET DATA MODELS
// ============================================================================

model SaleRecord {
  id                  String        @id
  canonicalCardId     String?
  source              MarketSource
  sourceId            String
  sourceUrl           String?
  soldPriceCents      Int
  currency            String        @default("USD")
  cardName            String
  setName             String?
  cardNumber          String?
  variant             String?
  gradeCompany        String?
  grade               Float?
  condition           String?
  soldAt              DateTime
  buyerFeeCents       Int           @default(0)
  shippingCents       Int           @default(0)
  totalBuyerCostCents Int
  dataQuality         Float         @default(0.5)
  ageDays             Int?
  weight              Float?
  createdAt           DateTime      @default(now())

  // Relations
  canonicalCard CanonicalCard? @relation(fields: [canonicalCardId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@index([canonicalCardId])
  @@index([soldAt])
  @@index([source])
  @@map("sale_records")
}

model MarketListing {
  id              String       @id
  canonicalCardId String?
  source          MarketSource
  sourceId        String
  sourceUrl       String?
  title           String
  rawTitle        String?
  priceCents      Int?
  currency        String       @default("USD")
  cardName        String?
  setName         String?
  cardNumber      String?
  variant         String?
  gradeCompany    String?
  grade           Float?
  condition       String?
  quantity        Int          @default(1)
  seller          String?
  sellerRating    Float?
  dataQuality     Float        @default(0.5)
  isActive        Boolean      @default(true)
  listedAt        DateTime?
  lastSeenAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  url             String?      @db.VarChar(500)
  seenAt          DateTime?

  // Relations
  canonicalCard CanonicalCard? @relation(fields: [canonicalCardId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  signals       Signal[]

  @@unique([source, sourceId])
  @@index([canonicalCardId])
  @@index([lastSeenAt])
  @@index([source, isActive])
  @@map("market_listings")
}

model UnifiedMarketListing {
  id           String       @id
  source       MarketSource
  sourceId     String
  title        String
  rawTitle     String?
  cardName     String?
  setName      String?
  cardNumber   String?
  variant      String?
  grade        Float?
  gradeCompany String?
  condition    String?
  priceCents   Int?
  currency     String       @default("USD")
  url          String?
  dataQuality  Float        @default(0.5)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([source, sourceId])
  @@index([priceCents])
  @@map("UnifiedMarketListing")
}

// ============================================================================
// SIGNAL & PRICING MODELS
// ============================================================================

model CardSignal {
  id                 String    @id
  canonicalCardId    String    @unique
  salesPerWeek       Float     @default(0)
  daysToClear        Float?
  pSell30d           Float?
  pSell60d           Float?
  pSell90d           Float?
  activeListings     Int       @default(0)
  marketVelocity     String?
  tfvCents           Int?
  floorPriceCents    Int?
  discountPct        Float?
  opportunityScore   Float     @default(0)
  opportunityRank    String?
  recommendation     String?
  riskScore          Float     @default(0)
  riskFactors        String[]
  hasArbitrage       Boolean   @default(false)
  arbitrageSpreadPct Float?
  arbitrageVenues    String[]
  signalStrength     Float     @default(0)
  lastComputed       DateTime  @default(now())
  expiresAt          DateTime  @default(now())

  // Relations
  canonicalCard CanonicalCard @relation(fields: [canonicalCardId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([opportunityScore])
  @@index([hasArbitrage, arbitrageSpreadPct])
  @@map("card_signals")
}

model ConsensusPricing {
  id                   String    @id
  canonicalCardId      String
  gradeCompany         String?
  grade                Float?
  layer1DirectPrice    Int?
  layer1Confidence     Float     @default(0)
  layer1Sources        String[]
  layer2ExactPrice     Int?
  layer2Confidence     Float     @default(0)
  layer2Sources        String[]
  layer2CompCount      Int       @default(0)
  layer3ClosePrice     Int?
  layer3Confidence     Float     @default(0)
  layer3Sources        String[]
  layer3CompCount      Int       @default(0)
  layer4EstimatedPrice Int?
  layer4Confidence     Float     @default(0)
  layer4Sources        String[]
  consensusPriceCents  Int
  confidenceScore      Float
  sourceCount          Int
  minPriceCents        Int?
  maxPriceCents        Int?
  medianPriceCents     Int?
  stdDevCents          Int?
  lastUpdated          DateTime  @default(now())
  nextUpdateDue        DateTime  @default(now())

  // Relations
  canonicalCard CanonicalCard @relation(fields: [canonicalCardId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([canonicalCardId, gradeCompany, grade])
  @@index([confidenceScore])
  @@index([consensusPriceCents])
  @@map("consensus_pricing")
}

model RedditSignal {
  id              String   @id
  canonicalCardId String?
  cardName        String
  setName         String?
  subreddit       String // "PokeInvesting" or "PokemonTCG"
  postId          String
  postTitle       String
  postUrl         String
  author          String
  score           Int      @default(0)
  numComments     Int      @default(0)
  sentiment       String // "BULLISH", "BEARISH", "NEUTRAL"
  sentimentScore  Float // -1.0 to 1.0
  confidence      Float // 0.0 to 1.0
  discussionVolume Int     @default(1)
  keyPhrases      String[] // ["investment", "buy", "hold", etc.]
  createdAt       DateTime @default(now())
  scrapedAt       DateTime @default(now())
  expiresAt       DateTime // Signal expires after 7 days

  // Relations
  canonicalCard CanonicalCard? @relation(fields: [canonicalCardId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@unique([subreddit, postId, cardName])
  @@index([cardName])
  @@index([sentiment])
  @@index([sentimentScore])
  @@index([scrapedAt])
  @@index([expiresAt])
  @@map("reddit_signals")
}

// ============================================================================
// LEGACY MODELS (Keep for backward compatibility)
// ============================================================================

model Card {
  id              String          @id @default(cuid())
  name            String          @db.VarChar(255)
  set             String          @db.VarChar(255) // Set name for bot compatibility
  number          String          @db.VarChar(10)
  variant         String?         @db.VarChar(100)
  grade           String?         @db.VarChar(20)
  condition       String?         @db.VarChar(50)
  language        String          @default("EN") @db.VarChar(10)
  normalizedName  String          @default("") @db.VarChar(255)
  setCode         String          @default("") @db.VarChar(50)
  rarity          String?         @db.VarChar(50)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cardKey         String?         @db.VarChar(100)
  cardType        String          @default("Pokemon") @db.VarChar(50)
  isValidated     Boolean         @default(false)
  lastValidated   DateTime?
  validationScore Float           @default(0.0)
  cardSet         CardSet?        @relation(fields: [setCode], references: [code])
  compSales       CompSale[]
  dataQuality     DataQuality[]
  evaluations     Evaluation[]
  listings        Listing[]
  opportunities   Opportunity[]
  signals         Signal[]
  watchlistItems  WatchlistItem[]

  // Data warehouse relations
  priceSnapshots  PriceSnapshot[]
  signalSnapshots SignalSnapshot[]
  dailyStats      DailyCardStats[]

  @@unique([set, number, variant, grade, language])
  @@index([cardKey])
  @@index([isValidated, validationScore])
  @@index([normalizedName])
  @@index([setCode, number])
}

model CardSet {
  id         String  @id
  code       String  @unique @db.VarChar(50)
  name       String  @db.VarChar(255)
  year       Int?
  totalCards Int?
  isActive   Boolean @default(true)
  cards      Card[]

  @@index([code])
  @@index([year])
}

model CompSale {
  id         String   @id
  cardId     String
  currency   String   @default("USD") @db.VarChar(3)
  source     String   @db.VarChar(50)
  priceCents Int
  soldAt     DateTime
  condition  String?  @db.VarChar(50)
  grade      String?  @db.VarChar(20)
  isVerified Boolean  @default(false)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([priceCents])
  @@index([soldAt])
  @@index([source])
  @@index([cardId, soldAt(sort: Desc), priceCents], map: "idx_compsale_recent_card")
}

model CrossReferenceData {
  id              String   @id
  listingId       String   @unique @db.VarChar(191)
  pokemonTcgId    String?  @db.VarChar(100)
  tcgPlayerData   Json?
  matchConfidence Float    @default(0.0)
  matchType       String   @db.VarChar(20)
  discrepancies   String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([matchConfidence])
  @@index([matchType])
  @@index([pokemonTcgId])
}

model DataQuality {
  id              String   @id
  checkedAt       DateTime @default(now())
  entityId        String   @db.VarChar(100)
  entityType      String   @db.VarChar(50)
  isValid         Boolean  @default(false)
  qualityScore    Float
  recommendations String[] @default([])
  issues          String[] @default([])
  card            Card     @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "DataQuality_card_fkey")

  @@index([checkedAt])
  @@index([entityType, entityId])
  @@index([isValid])
  @@index([qualityScore])
}

model Evaluation {
  id               String   @id
  cardId           String
  listingId        String
  fairValue        Float
  discount         Float
  investmentThesis String
  riskLevel        String   @db.VarChar(20)
  projectedReturn  Float?
  confidence       Float
  createdAt        DateTime @default(now())
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([confidence])
  @@index([createdAt])
}

model Listing {
  id            String        @id
  cardId        String
  source        String        @db.VarChar(50)
  price         Float
  currency      String        @default("USD") @db.VarChar(3)
  url           String        @db.VarChar(500)
  seller        String?       @db.VarChar(255)
  isActive      Boolean       @default(true)
  scrapedAt     DateTime      @default(now())
  condition     String?       @db.VarChar(50)
  grade         String?       @db.VarChar(20)
  externalId    String        @db.VarChar(100)
  shippingPrice Float?        @default(0.0)
  totalPrice    Float?
  isVerified    Boolean       @default(false)
  lastSeen      DateTime      @default(now())
  evaluations   Evaluation[]
  card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([cardId])
  @@index([price])
  @@index([scrapedAt])
  @@index([source, isActive])
}

model Opportunity {
  id                  String            @id
  cardId              String
  listingId           String
  sourceBuy           String            @db.VarChar(50)
  sourceSell          String            @db.VarChar(50)
  buyPriceCents       Int
  buyShippingCents    Int               @default(0)
  buyFeesCents        Int               @default(0)
  sellCompCents       Int
  sellFeesCents       Int               @default(0)
  sellShippingCents   Int               @default(0)
  expectedProfitCents Int
  netSpreadBps        Int
  confidence          Float             @default(0)
  rationale           String            @default("")
  status              OpportunityStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isValidated         Boolean           @default(false)
  validationErrors    String[]          @default([])
  card                Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, listingId, createdAt])
  @@index([cardId, createdAt])
  @@index([confidence])
  @@index([netSpreadBps])
  @@index([status, createdAt])
}

model PipelineExecution {
  id                   String    @id
  sources              String[]
  mode                 String    @db.VarChar(20)
  totalListings        Int       @default(0)
  totalOpportunities   Int       @default(0)
  totalProfitPotential Int       @default(0)
  duration             Int       @default(0)
  status               String    @default("RUNNING") @db.VarChar(20)
  errorMessage         String?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  @@index([mode])
  @@index([sources])
  @@index([status, createdAt])
}

model PortfolioCollection {
  id                   String                 @id
  name                 String                 @db.VarChar(255)
  slug                 String                 @unique @db.VarChar(100)
  description          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  unifiedPortfolioItems UnifiedPortfolioItem[]

  @@index([slug])
}

model PostQueue {
  id          String    @id
  payload     Json
  status      String    @default("PENDING") @db.VarChar(20)
  scheduledAt DateTime  @default(now())
  postedAt    DateTime?

  @@index([status, scheduledAt])
}

model Signal {
  id              String         @id
  cardId          String
  marketListingId String?
  edgeBp          Int
  confidence      Float
  thesis          String
  createdAt       DateTime       @default(now())
  isValidated     Boolean        @default(false)
  status          String         @default("ACTIVE") @db.VarChar(20)
  updatedAt       DateTime       @updatedAt
  card            Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  marketListing   MarketListing? @relation(fields: [marketListingId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([confidence])
  @@index([edgeBp])
  @@index([status])
  @@index([marketListingId])
}

model FeatureSnapshot {
  id           String   @id @default(cuid())
  cardId       String
  windowDays   Int
  medianCents  Int?
  p05Cents     Int?
  p95Cents     Int?
  volume       Int      @default(0)
  volatilityBp Int?
  nhiScore     Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([cardId, windowDays])
  @@index([cardId])
  @@index([windowDays])
}

model UnifiedPortfolioItem {
  id                  String              @id
  collectionId        String
  listingId           String              @db.VarChar(191)
  addedAt             DateTime            @default(now())
  tags                String[]            @default([])
  portfolioCollection PortfolioCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, listingId])
  @@index([addedAt])
  @@index([collectionId])
  @@index([listingId])
}

model User {
  id           String   @id @default(cuid())
  telegramId   String?  @unique
  discordId    String?  @unique
  username     String?  @db.VarChar(255)
  firstName    String?  @db.VarChar(255)
  lastName     String?  @db.VarChar(255)
  referralCode String   @unique @db.VarChar(50)
  referredBy   String?  @db.VarChar(50)
  walletAddress String? @db.VarChar(255)
  createdAt    DateTime @default(now())

  purchases       Purchase[]
  watchlistItems  WatchlistItem[]
  referralEvents  ReferralEvent[]
  preferences     UserPreference?

  // Data warehouse relations
  userQueries     UserQuery[]
  userActions     UserAction[]
  userOutcomes    UserOutcome[]
  alertDeliveries AlertDelivery[]

  @@index([referralCode])
  @@index([telegramId])
  @@index([discordId])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  alertsEnabled   Boolean  @default(true)
  minDiscountPct  Float    @default(10)
  minPriceUsd     Float    @default(0)
  maxPriceUsd     Float    @default(10000)
  grades          String[] @default(["PSA 10", "PSA 9", "CGC 10", "BGS 10"])
  quietHoursStart String?  // HH:MM format or hour in UTC
  quietHoursEnd   String?  // HH:MM format or hour in UTC
  snoozedCards    Json?    @default("{}") // Map<cardId, expiresAt timestamp>
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReferralEvent {
  id        String   @id @default(cuid())
  code      String   @db.VarChar(50)
  path      String   @db.VarChar(500)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  amount    Int      // Amount in cents
  fee       Int      // Fee in cents
  status    String   @default("COMPLETED") @db.VarChar(20)
  txHash    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_watchlist_user_recent")
}

// ============================================================================
// ENUMS
// ============================================================================

enum DemandTrend {
  RISING
  STABLE
  FALLING
}

enum LiquidityLevel {
  HIGH
  MEDIUM
  LOW
}

enum MarketSource {
  EBAY
  TCGPLAYER
  FANATICS
  COLLECTOR_CRYPT
  MANUAL
  CSV
  PHYGITALS
  COURTYARD
  JUSTTCG
  OPENSEA
  MAGICEDEN
  POKEPRICE_TRACKER
  POKEMON_TCG_API
}

enum OpportunityStatus {
  PENDING
  POSTED
  EXPIRED
  RETRACTED
  INVALID
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ===========================================
// DATA WAREHOUSE MODELS (2026-01-25)
// ===========================================

model PriceSnapshot {
  id              String   @id @default(cuid())
  cardId          String?
  card            Card?    @relation(fields: [cardId], references: [id])
  cardKey         String?
  source          String
  sourceVersion   String   @default("v1")
  externalId      String?
  priceCents      Int
  currency        String   @default("USD")
  grade           String?
  grader          String?
  gradeNumeric    Float?
  condition       String?
  listingType     String?
  sellerId        String?
  sellerRating    Float?
  listedAt        DateTime?
  soldAt          DateTime?
  country         String?
  shippingCents   Int?
  raw             Json?
  rawHash         String?
  timestamp       DateTime @default(now())
  parserVersion   String   @default("1.0.0")

  @@unique([source, externalId])
  @@index([cardId, source, timestamp])
  @@index([cardKey, timestamp])
  @@index([rawHash])
}

model SignalSnapshot {
  id              String   @id @default(cuid())
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id])
  cardKey         String?
  timestamp       DateTime @default(now())
  fairValueCents  Int
  confidenceScore Float
  trendDirection  String?
  trendPct        Float?
  trendPeriodDays Int?
  liquidityScore  Float?
  activeListings  Int?
  avgDaysOnMarket Float?
  velocity30d     Int?
  sentimentScore  Float?
  sentimentLabel  String?
  sentimentPostCount Int?
  psa10Pop        Int?
  totalPop        Int?
  scarcityScore   Float?
  arbitrageOpportunities Json?

  @@index([cardId, timestamp])
  @@index([cardKey, timestamp])
}

model ThesisRecord {
  id              String   @id @default(cuid())
  opportunityId   String   @unique
  thesis          String   @db.Text
  recommendation  String
  usedLLM         Boolean  @default(false)
  modelName       String?
  promptTokens    Int?
  completionTokens Int?
  costCents       Float?
  generationTimeMs Int
  signalsSnapshot Json?
  createdAt       DateTime @default(now())

  @@index([recommendation])
  @@index([usedLLM])
}

model UserQuery {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  platform        String
  rawText         String   @db.Text
  intentType      String?
  entities        Json?
  responseTimeMs  Int?
  timestamp       DateTime @default(now())

  @@index([userId, timestamp])
  @@index([platform, timestamp])
}

model UserAction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  opportunityId   String?
  action          String
  platform        String
  source          String?
  timeToActionMs  Int?
  timestamp       DateTime @default(now())

  @@index([userId, timestamp])
  @@index([opportunityId])
}

model UserOutcome {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  opportunityId       String?
  cardId              String?
  purchasePriceCents  Int
  purchaseDate        DateTime @default(now())
  grade               String?
  status              String   @default("HOLDING")
  currentValueCents   Int?
  realizedReturnPct   Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status])
  @@index([cardId])
}

model AlertDelivery {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  opportunityId   String
  platform        String
  status          String
  messageId       String?
  sentAt          DateTime @default(now())
  readAt          DateTime?
  clickedAt       DateTime?

  @@index([userId, sentAt])
  @@index([opportunityId])
  @@index([status])
}

model DailyCardStats {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id])
  cardKey         String?
  openPriceCents  Int
  closePriceCents Int
  highPriceCents  Int
  lowPriceCents   Int
  avgPriceCents   Int
  medianPriceCents Int
  volume          Int      @default(0)
  salesCount      Int      @default(0)
  listingsCount   Int      @default(0)

  @@unique([date, cardId])
  @@index([date])
  @@index([cardId])
}

model DailyMarketStats {
  id                  String   @id @default(cuid())
  date                DateTime @db.Date @unique
  totalVolume         Float    @default(0)
  totalSaleCount      Int      @default(0)
  totalListingCount   Int      @default(0)
  activeCardCount     Int      @default(0)
  avgPriceChangePct   Float?
  topGainers          Json?
  topLosers           Json?
  sentimentAvg        Float?

  @@index([date])
}

model DailySourceStats {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  source          String
  snapshotCount   Int      @default(0)
  uniqueCardCount Int      @default(0)
  saleCount       Int      @default(0)
  listingCount    Int      @default(0)
  avgPriceCents   Int      @default(0)

  @@unique([date, source])
  @@index([date])
}
