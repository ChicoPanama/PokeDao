generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === DATA INTEGRITY ENFORCEMENT ===
// This schema enforces 10/10 data integrity with strict validation

// === CANONICAL CARD MODEL ===
// Single source of truth for all Pokemon cards
model Card {
  id        String  @id @default(cuid())
  
  // REQUIRED CORE FIELDS - No nulls allowed
  name      String  @db.VarChar(255)
  setCode   String? @db.VarChar(50)  // Canonical set code (e.g., "base1", "jungle")
  number    String? @db.VarChar(10)  // Card number (e.g., "4", "15a")
  
  // OPTIONAL ENHANCEMENT FIELDS
  variant   String? @db.VarChar(100) // holo, reverse, alt-art, etc.
  grade     String? @db.VarChar(20)  // PSA 9, BGS 10, raw, etc.
  condition String? @db.VarChar(50)  // Near Mint, Played, etc.
  language  String  @default("EN") @db.VarChar(10) // EN, JP, etc.
  
  // NORMALIZATION FIELDS - Auto-generated
  normalizedName String? @db.VarChar(255) // Normalized card name
  cardKey        String? @unique @db.VarChar(100) // Unique identifier
  rarity         String? @db.VarChar(50)
  cardType       String? @default("Pokemon") @db.VarChar(50)
  
  // VALIDATION FIELDS
  isValidated    Boolean @default(false)
  validationScore Float  @default(0.0)
  lastValidated  DateTime?
  
  // AUDIT TRAIL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  listings       Listing[]
  compSales      CompSale[]
  marketListings MarketListing[]
  opportunities  Opportunity[]
  signals        Signal[]
  qualityReports DataQuality[]
  evaluations    Evaluation[]
  watchlistItems WatchlistItem[]
  cardSet        CardSet? @relation(fields: [setCode], references: [code])

  // UNIQUE CONSTRAINTS - Prevent duplicates
  @@unique([setCode, number, variant, grade, language])
  @@index([cardKey])
  @@index([normalizedName])
  @@index([setCode, number])
  @@index([isValidated, validationScore])
}

// === CANONICAL SET MODEL ===
// Validates all set codes against known sets
model CardSet {
  id          String  @id @default(cuid())
  code        String  @unique @db.VarChar(50) // Canonical code
  name        String  @db.VarChar(255)        // Full name
  year        Int?                            // Release year
  totalCards  Int?                            // Total cards in set
  isActive    Boolean @default(true)          // Still in use
  
  // RELATIONS
  cards       Card[]
  
  @@index([code])
  @@index([year])
}

// === VALIDATED LISTING MODEL ===
model Listing {
  id              String   @id @default(cuid())
  cardId          String
  source          String   @db.VarChar(50)    // ebay, tcgplayer, etc.
  externalId      String   @db.VarChar(100)   // Source-specific ID
  price           Float                        // Price in USD
  currency        String   @default("USD") @db.VarChar(3)
  url             String   @db.VarChar(500)
  
  // OPTIONAL FIELDS
  seller          String?  @db.VarChar(255)
  condition       String?  @db.VarChar(50)
  grade           String?  @db.VarChar(20)
  shippingPrice   Float?   @default(0.0)
  totalPrice      Float?   // price + shipping
  
  // STATUS FIELDS
  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  
  // TIMESTAMPS
  scrapedAt       DateTime @default(now())
  lastSeen        DateTime @default(now())
  
  // RELATIONS
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  qualityReports  DataQuality[]
  evaluations     Evaluation[]
  
  // CONSTRAINTS
  @@unique([source, externalId])
  @@index([cardId])
  @@index([source, isActive])
  @@index([price])
  @@index([scrapedAt])
}

// === VALIDATED MARKET LISTING MODEL ===
model MarketListing {
  id         String   @id @default(cuid())
  source     String   @db.VarChar(50)
  sourceId   String   @db.VarChar(100)
  cardId     String
  url        String   @db.VarChar(500)
  priceCents Int                        // Price in cents for precision
  currency   String   @default("USD") @db.VarChar(3)
  
  // OPTIONAL FIELDS
  shippingCents Int?  @default(0)
  condition     String? @db.VarChar(50)
  grade         String? @db.VarChar(20)
  seller        String? @db.VarChar(255)
  
  // STATUS
  isActive      Boolean  @default(true)
  seenAt        DateTime @default(now())
  
  // RELATIONS
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  signals       Signal[]
  
  // CONSTRAINTS
  @@unique([source, sourceId])
  @@index([cardId])
  @@index([source, isActive])
  @@index([priceCents])
  @@index([seenAt])
}

// === VALIDATED COMP SALES MODEL ===
model CompSale {
  id          String   @id @default(cuid())
  cardId      String
  source      String   @db.VarChar(50)
  priceCents  Int                        // Price in cents
  currency    String   @default("USD") @db.VarChar(3)
  soldAt      DateTime
  condition   String?  @db.VarChar(50)
  grade       String?  @db.VarChar(20)
  
  // VALIDATION
  isVerified  Boolean  @default(false)
  
  // RELATIONS
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  @@index([cardId])
  @@index([source])
  @@index([soldAt])
  @@index([priceCents])
}

// === OPPORTUNITY MODEL ===
enum OpportunityStatus {
  PENDING
  POSTED
  EXPIRED
  RETRACTED
  INVALID
}

model Opportunity {
  id                  String             @id @default(cuid())
  cardId              String
  listingId           String
  sourceBuy           String   @db.VarChar(50)
  sourceSell          String   @db.VarChar(50)

  // PRICING (in cents for precision)
  buyPriceCents       Int
  buyShippingCents    Int               @default(0)
  buyFeesCents        Int               @default(0)
  sellCompCents       Int
  sellFeesCents       Int               @default(0)
  sellShippingCents   Int               @default(0)

  // CALCULATED FIELDS
  expectedProfitCents Int
  netSpreadBps        Int               // Basis points
  confidence          Float             @default(0.0)
  rationale           String            @default("")
  status              OpportunityStatus @default(PENDING)

  // VALIDATION
  isValidated         Boolean           @default(false)
  validationErrors    String[]          @default([])

  // TIMESTAMPS
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // RELATIONS
  card                Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  listing             MarketListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([status, createdAt])
  @@index([netSpreadBps])
  @@index([confidence])
  @@unique([cardId, listingId, createdAt])
}

// === SIGNAL MODEL ===
model Signal {
  id              String   @id @default(cuid())
  cardId          String
  listingId       String
  edgeBp          Int                        // Edge in basis points
  confidence      Float                      // 0.0 to 1.0
  thesis          String   @db.Text
  status          String   @default("ACTIVE") @db.VarChar(20)
  
  // VALIDATION
  isValidated     Boolean  @default(false)
  
  // TIMESTAMPS
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // RELATIONS
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  listing         MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([edgeBp])
  @@index([confidence])
  @@index([status])
}

// === DATA QUALITY MODEL ===
model DataQuality {
  id              String   @id @default(cuid())
  entityType      String   @db.VarChar(50)    // Card, Listing, etc.
  entityId        String   @db.VarChar(100)
  qualityScore    Float                        // 0.0 to 1.0
  issues          String[] @default([])       // List of issues found
  recommendations String[] @default([])       // List of recommendations
  isValid         Boolean  @default(false)
  
  // TIMESTAMPS
  checkedAt       DateTime @default(now())
  
  // RELATIONS
  card            Card?    @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "DataQuality_card_fkey")
  listing         Listing? @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "DataQuality_listing_fkey")

  @@index([entityType, entityId])
  @@index([qualityScore])
  @@index([isValid])
  @@index([checkedAt])
}

// === POST QUEUE MODEL ===
model PostQueue {
  id          String   @id @default(cuid())
  payload     Json                         // Post content
  status      String   @default("PENDING") @db.VarChar(20)
  scheduledAt DateTime @default(now())
  postedAt    DateTime?
  
  @@index([status, scheduledAt])
}

// === USER MODEL ===
model User {
  id           String   @id @default(cuid())
  telegramId   String   @unique
  username     String?  @db.VarChar(255)
  firstName    String?  @db.VarChar(255)
  lastName     String?  @db.VarChar(255)
  referralCode String   @unique @db.VarChar(50)
  referredBy   String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  @@index([telegramId])
  @@index([referralCode])
}

// === EVALUATION MODEL ===
model Evaluation {
  id               String   @id @default(cuid())
  cardId           String
  listingId        String
  fairValue        Float
  discount         Float
  investmentThesis String   @db.Text
  riskLevel        String   @db.VarChar(20)
  projectedReturn  Float?
  confidence       Float
  createdAt        DateTime @default(now())

  // RELATIONS
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([confidence])
  @@index([createdAt])
}

// === WATCHLIST MODEL ===
model WatchlistItem {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  // RELATIONS
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

// === UNIFIED MARKET MODELS ===
// New unified models for the market pipeline system

// Market sources enum
enum MarketSource {
  EBAY
  TCGPLAYER
  FANATICS
  COLLECTOR_CRYPT
  MANUAL
  CSV
}

// Grade companies enum
enum GradeCompany {
  RAW
  PSA
  BGS
  CGC
  SGC
  OTHER
}

// Risk levels enum
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Liquidity levels enum
enum LiquidityLevel {
  HIGH
  MEDIUM
  LOW
}

// Demand trends enum
enum DemandTrend {
  RISING
  STABLE
  FALLING
}

// Unified market listing model
model UnifiedMarketListing {
  id           String   @id @db.VarChar(191) // canonical id
  source       MarketSource
  sourceId     String   @db.VarChar(100)
  title        String   @db.VarChar(500)
  rawTitle     String   @db.VarChar(500)
  cardName     String?  @db.VarChar(255)
  setName      String?  @db.VarChar(255)
  cardNumber   String?  @db.VarChar(10)
  variant      String?  @db.VarChar(100)
  gradeCompany GradeCompany?
  grade        Float?
  condition    String?  @db.VarChar(50)
  priceCents   Int                        // Price in USD cents
  currency     String   @default("USD") @db.VarChar(3)
  shippingCents Int?    @default(0)       // Shipping cost in USD cents
  location     String?  @db.VarChar(255)
  listedAt     DateTime?
  url          String?  @db.VarChar(500)
  dataQuality  Float?   @default(0.0)     // Data quality score 0-1
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RELATIONS
  portfolioItems    UnifiedPortfolioItem[]
  arbitrageOpportunities UnifiedArbitrageOpportunity[]

  // CONSTRAINTS
  @@unique([source, sourceId])
  @@index([cardName])
  @@index([setName, cardNumber])
  @@index([gradeCompany, grade])
  @@index([priceCents])
  @@index([dataQuality])
  @@index([source])
  @@index([createdAt])
}

// Portfolio collection model
model PortfolioCollection {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // RELATIONS
  items       UnifiedPortfolioItem[]

  @@index([slug])
}

// Portfolio item linking collections to listings
model UnifiedPortfolioItem {
  id           String   @id @default(cuid())
  collectionId String
  listingId    String   @db.VarChar(191)
  addedAt      DateTime @default(now())
  tags         String[] @default([]) @db.Text

  // RELATIONS
  collection   PortfolioCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listing      UnifiedMarketListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([collectionId, listingId])
  @@index([collectionId])
  @@index([listingId])
  @@index([addedAt])
}

// Unified arbitrage opportunity model
model UnifiedArbitrageOpportunity {
  id                   String   @id @default(cuid())
  listingId            String   @db.VarChar(191)
  source               MarketSource
  expectedResaleCents  Int                        // Expected resale price in USD cents
  expectedFeesCents    Int                        // Expected fees in USD cents
  expectedShippingCents Int                       // Expected shipping in USD cents
  netProfitCents       Int                        // Net profit in USD cents
  marginPct            Float                      // Profit margin percentage
  liquidity            LiquidityLevel
  velocity             Float                      // Sales velocity 0-1
  demand               DemandTrend
  volatility           Float                      // Price volatility 0-1
  confidence           Float                      // Confidence score 0-1
  risk                 RiskLevel
  collectionTags       String[] @default([]) @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // RELATIONS
  listing              UnifiedMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([createdAt])
  @@index([marginPct, confidence])
  @@index([risk])
  @@index([liquidity])
  @@index([netProfitCents])
}

// Cross-reference data model
model CrossReferenceData {
  id                String   @id @default(cuid())
  listingId         String   @db.VarChar(191)
  pokemonTcgId      String?  @db.VarChar(100)
  tcgPlayerData     Json?    // JSON data from TCGPlayer
  matchConfidence   Float    @default(0.0)
  matchType         String   @db.VarChar(20) // 'exact', 'fuzzy', 'partial', 'none'
  discrepancies     String[] @default([]) @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([listingId])
  @@index([pokemonTcgId])
  @@index([matchConfidence])
  @@index([matchType])
}

// Pipeline execution log
model PipelineExecution {
  id              String   @id @default(cuid())
  sources         String[] @db.Text // Array of sources processed
  mode            String   @db.VarChar(20) // conservative, default, aggressive
  totalListings   Int      @default(0)
  totalOpportunities Int   @default(0)
  totalProfitPotential Int @default(0) // In USD cents
  duration        Int      @default(0) // Duration in milliseconds
  status          String   @default("RUNNING") @db.VarChar(20)
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([status, createdAt])
  @@index([sources])
  @@index([mode])
}