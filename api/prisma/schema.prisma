generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              String          @id
  name            String          @db.VarChar(255)
  number          String          @db.VarChar(10)
  variant         String?         @db.VarChar(100)
  grade           String?         @db.VarChar(20)
  condition       String?         @db.VarChar(50)
  language        String          @default("EN") @db.VarChar(10)
  normalizedName  String          @db.VarChar(255)
  setCode         String          @db.VarChar(50)
  rarity          String?         @db.VarChar(50)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  cardKey         String          @unique @db.VarChar(100)
  cardType        String          @default("Pokemon") @db.VarChar(50)
  isValidated     Boolean         @default(false)
  lastValidated   DateTime?
  validationScore Float           @default(0.0)
  CardSet         CardSet         @relation(fields: [setCode], references: [code])
  CompSale        CompSale[]
  DataQuality     DataQuality[]
  Evaluation      Evaluation[]
  Listing         Listing[]
  MarketListing   MarketListing[]
  Opportunity     Opportunity[]
  Signal          Signal[]
  WatchlistItem   WatchlistItem[]

  @@unique([setCode, number, variant, grade, language])
  @@index([cardKey])
  @@index([isValidated, validationScore])
  @@index([normalizedName])
  @@index([setCode, number])
}

model CardSet {
  id         String  @id
  code       String  @unique @db.VarChar(50)
  name       String  @db.VarChar(255)
  year       Int?
  totalCards Int?
  isActive   Boolean @default(true)
  Card       Card[]

  @@index([code])
  @@index([year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CompSale {
  id         String   @id
  cardId     String
  currency   String   @default("USD") @db.VarChar(3)
  source     String   @db.VarChar(50)
  priceCents Int
  soldAt     DateTime
  condition  String?  @db.VarChar(50)
  grade      String?  @db.VarChar(20)
  isVerified Boolean  @default(false)
  Card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([priceCents])
  @@index([soldAt])
  @@index([source])
}

model CrossReferenceData {
  id              String   @id
  listingId       String   @unique @db.VarChar(191)
  pokemonTcgId    String?  @db.VarChar(100)
  tcgPlayerData   Json?
  matchConfidence Float    @default(0.0)
  matchType       String   @db.VarChar(20)
  discrepancies   String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([matchConfidence])
  @@index([matchType])
  @@index([pokemonTcgId])
}

model DataQuality {
  id              String   @id
  checkedAt       DateTime @default(now())
  entityId        String   @db.VarChar(100)
  entityType      String   @db.VarChar(50)
  isValid         Boolean  @default(false)
  qualityScore    Float
  recommendations String[] @default([])
  issues          String[] @default([])
  Card            Card     @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "DataQuality_card_fkey")
  Listing         Listing  @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "DataQuality_listing_fkey")

  @@index([checkedAt])
  @@index([entityType, entityId])
  @@index([isValid])
  @@index([qualityScore])
}

model Evaluation {
  id               String   @id
  cardId           String
  listingId        String
  fairValue        Float
  discount         Float
  investmentThesis String
  riskLevel        String   @db.VarChar(20)
  projectedReturn  Float?
  confidence       Float
  createdAt        DateTime @default(now())
  Card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  Listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([confidence])
  @@index([createdAt])
}

model Listing {
  id            String        @id
  cardId        String
  source        String        @db.VarChar(50)
  price         Float
  currency      String        @default("USD") @db.VarChar(3)
  url           String        @db.VarChar(500)
  seller        String?       @db.VarChar(255)
  isActive      Boolean       @default(true)
  scrapedAt     DateTime      @default(now())
  condition     String?       @db.VarChar(50)
  grade         String?       @db.VarChar(20)
  externalId    String        @db.VarChar(100)
  shippingPrice Float?        @default(0.0)
  totalPrice    Float?
  isVerified    Boolean       @default(false)
  lastSeen      DateTime      @default(now())
  DataQuality   DataQuality[]
  Evaluation    Evaluation[]
  Card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([cardId])
  @@index([price])
  @@index([scrapedAt])
  @@index([source, isActive])
}

model MarketListing {
  id            String        @id
  cardId        String
  source        String        @db.VarChar(50)
  sourceId      String        @db.VarChar(100)
  priceCents    Int
  currency      String        @default("USD") @db.VarChar(3)
  condition     String?       @db.VarChar(50)
  grade         String?       @db.VarChar(20)
  url           String        @db.VarChar(500)
  seenAt        DateTime      @default(now())
  isActive      Boolean       @default(true)
  seller        String?       @db.VarChar(255)
  shippingCents Int?          @default(0)
  Card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  Opportunity   Opportunity[]
  Signal        Signal[]

  @@unique([source, sourceId])
  @@index([cardId])
  @@index([priceCents])
  @@index([seenAt])
  @@index([source, isActive])
}

model Opportunity {
  id                  String            @id
  cardId              String
  listingId           String
  sourceBuy           String            @db.VarChar(50)
  sourceSell          String            @db.VarChar(50)
  buyPriceCents       Int
  buyShippingCents    Int               @default(0)
  buyFeesCents        Int               @default(0)
  sellCompCents       Int
  sellFeesCents       Int               @default(0)
  sellShippingCents   Int               @default(0)
  expectedProfitCents Int
  netSpreadBps        Int
  confidence          Float             @default(0)
  rationale           String            @default("")
  status              OpportunityStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  isValidated         Boolean           @default(false)
  validationErrors    String[]          @default([])
  Card                Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  MarketListing       MarketListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cardId, listingId, createdAt])
  @@index([cardId, createdAt])
  @@index([confidence])
  @@index([netSpreadBps])
  @@index([status, createdAt])
}

model PipelineExecution {
  id                   String    @id
  sources              String[]
  mode                 String    @db.VarChar(20)
  totalListings        Int       @default(0)
  totalOpportunities   Int       @default(0)
  totalProfitPotential Int       @default(0)
  duration             Int       @default(0)
  status               String    @default("RUNNING") @db.VarChar(20)
  errorMessage         String?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  @@index([mode])
  @@index([sources])
  @@index([status, createdAt])
}

model PortfolioCollection {
  id                   String                 @id
  name                 String                 @db.VarChar(255)
  slug                 String                 @unique @db.VarChar(100)
  description          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  UnifiedPortfolioItem UnifiedPortfolioItem[]

  @@index([slug])
}

model PostQueue {
  id          String    @id
  payload     Json
  status      String    @default("PENDING") @db.VarChar(20)
  scheduledAt DateTime  @default(now())
  postedAt    DateTime?

  @@index([status, scheduledAt])
}

model Signal {
  id            String        @id
  cardId        String
  listingId     String
  edgeBp        Int
  confidence    Float
  thesis        String
  createdAt     DateTime      @default(now())
  isValidated   Boolean       @default(false)
  status        String        @default("ACTIVE") @db.VarChar(20)
  updatedAt     DateTime
  Card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  MarketListing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([confidence])
  @@index([edgeBp])
  @@index([status])
}

model UnifiedArbitrageOpportunity {
  id                    String               @id
  listingId             String               @db.VarChar(191)
  source                MarketSource
  expectedResaleCents   Int
  expectedFeesCents     Int
  expectedShippingCents Int
  netProfitCents        Int
  marginPct             Float
  liquidity             LiquidityLevel
  velocity              Float
  demand                DemandTrend
  volatility            Float
  confidence            Float
  risk                  RiskLevel
  collectionTags        String[]             @default([])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime
  UnifiedMarketListing  UnifiedMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([liquidity])
  @@index([listingId])
  @@index([marginPct, confidence])
  @@index([netProfitCents])
  @@index([risk])
}

model UnifiedMarketListing {
  id                          String                        @id @db.VarChar(191)
  source                      MarketSource
  sourceId                    String                        @db.VarChar(100)
  title                       String                        @db.VarChar(500)
  rawTitle                    String                        @db.VarChar(500)
  cardName                    String?                       @db.VarChar(255)
  setName                     String?                       @db.VarChar(255)
  cardNumber                  String?                       @db.VarChar(10)
  variant                     String?                       @db.VarChar(100)
  gradeCompany                GradeCompany?
  grade                       Float?
  condition                   String?                       @db.VarChar(50)
  priceCents                  Int
  currency                    String                        @default("USD") @db.VarChar(3)
  shippingCents               Int?                          @default(0)
  location                    String?                       @db.VarChar(255)
  listedAt                    DateTime?
  url                         String?                       @db.VarChar(500)
  dataQuality                 Float?                        @default(0.0)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  UnifiedArbitrageOpportunity UnifiedArbitrageOpportunity[]
  UnifiedPortfolioItem        UnifiedPortfolioItem[]

  @@unique([source, sourceId])
  @@index([cardName])
  @@index([createdAt])
  @@index([dataQuality])
  @@index([gradeCompany, grade])
  @@index([priceCents])
  @@index([setName, cardNumber])
  @@index([source])
}

model UnifiedPortfolioItem {
  id                   String               @id
  collectionId         String
  listingId            String               @db.VarChar(191)
  addedAt              DateTime             @default(now())
  tags                 String[]             @default([])
  PortfolioCollection  PortfolioCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  UnifiedMarketListing UnifiedMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([collectionId, listingId])
  @@index([addedAt])
  @@index([collectionId])
  @@index([listingId])
}

model User {
  id           String   @id
  telegramId   String   @unique
  username     String?  @db.VarChar(255)
  firstName    String?  @db.VarChar(255)
  lastName     String?  @db.VarChar(255)
  referralCode String   @unique @db.VarChar(50)
  referredBy   String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  @@index([referralCode])
  @@index([telegramId])
}

model WatchlistItem {
  id        String   @id
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  Card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

enum DemandTrend {
  RISING
  STABLE
  FALLING
}

enum GradeCompany {
  RAW
  PSA
  BGS
  CGC
  SGC
  ACE
  OTHER
}

enum LiquidityLevel {
  HIGH
  MEDIUM
  LOW
}

enum MarketSource {
  JUSTTCG
  TCGPLAYER_ACTIVE
  EBAY
  TCGPLAYER
  FANATICS
  COLLECTOR_CRYPT
  MANUAL
  CSV
  PHYGITALS
  COURTYARD
}

enum OpportunityStatus {
  PENDING
  POSTED
  EXPIRED
  RETRACTED
  INVALID
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}
