{
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "files.associations": {
    "api/prisma/schema.prisma": "prisma",
    "**/backup/**/*.prisma": "plaintext",
    "**/*.backup": "plaintext",
    "**/*.plan.backup": "plaintext",
    "research/**/*.prisma": "plaintext",
    "prisma/**/*.prisma": "plaintext",
    "schema-phase1-plan.prisma": "plaintext"
  },
  "files.exclude": {
    "**/.pnpm": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/research/**/generated": true,
    "**/research/**/*.prisma": true,
    "prisma/**/*.prisma": true,
    "**/*.backup": true,
    "**/*.plan.backup": true,
    "**/research-backup-*": true
  },
  "search.exclude": {
    "**/.pnpm": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/research/**/generated": true,
    "**/research/**/*.prisma": true,
    "prisma/**/*.prisma": true,
    "**/*.backup": true,
    "**/research-backup-*": true
  },
  "files.watcherExclude": {
    "**/.pnpm/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/research/**/generated/**": true,
    "**/research/**/*.prisma": true,
    "prisma/**/*.prisma": true,
    "**/*.backup": true,
    "**/research-backup-*/**": true
  },
  "prisma.fileWatcher": false,
  "prisma.schemaPath": "./api/prisma/schema.prisma"
}
