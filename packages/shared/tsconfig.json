{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist",
    "typeRoots": ["./types", "../../node_modules/@types"],
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": false,
    "strict": false,
    "types": ["node"],
    "composite": true
  },
  "include": ["types", "./**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../../api" }
  ]
}
