{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@pokedao/core": ["./packages/core/src/index.ts"],
      "@pokedao/core/*": ["./packages/core/src/*"],
      "@pokedao/analysis": ["./packages/analysis/src/index.ts"],
      "@pokedao/analysis/*": ["./packages/analysis/src/*"],
      "@pokedao/storage": ["./packages/storage/src/index.ts"],
      "@pokedao/storage/*": ["./packages/storage/src/*"],
      "@pokedao/adapters": ["./packages/adapters/src/index.ts"],
      "@pokedao/adapters/*": ["./packages/adapters/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
