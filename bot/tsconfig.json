{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "typeRoots": ["./types", "../node_modules/@types", "../../node_modules/@types"],
    "noImplicitAny": false,
    "strict": false,
    "composite": true
  },
  "include": ["src", "types"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../api" }
  ]
}
