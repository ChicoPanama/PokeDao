{
  "name": "@pokedao/mew1a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project Mew-1A: TCG-specific pricing AI model (fine-tuned Llama-3.2-3B)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
