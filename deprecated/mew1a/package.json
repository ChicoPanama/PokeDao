    "inference:test": "tsx src/inference/test-model.ts"
  },
  "dependencies": {
    "@huggingface/inference": "^2.8.1",
    "@pokedao/core": "workspace:*",
    "@pokedao/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  }
