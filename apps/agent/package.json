{
  "name": "@pokedao/agent",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "tick": "tsx src/tick.ts",
    "workers": "tsx src/workers/index.ts",
    "workers:dev": "tsx watch src/workers/index.ts",
    "processor": "tsx src/processor/index.ts",
    "processor:dev": "tsx watch src/processor/index.ts",
    "warehouse": "tsx src/collectors/data-warehouse.ts",
    "warehouse:now": "tsx src/collectors/data-warehouse.ts --run-now",
    "all": "concurrently \"pnpm workers\" \"pnpm processor\" \"pnpm warehouse\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.16",
    "@langchain/langgraph": "^1.1.2",
    "@pokedao/adapters": "workspace:*",
    "@pokedao/shared": "workspace:*",
    "@prisma/adapter-pg": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^4.15.4",
    "cheerio": "^1.2.0",
    "cron": "^3.5.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.7.0",
    "openai": "^5.20.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/cron": "^2.4.3",
    "concurrently": "^9.0.0"
  }
}
