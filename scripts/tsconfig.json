{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "outDir": "../dist/scripts",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "moduleResolution": "NodeNext",
  "allowImportingTsExtensions": true,
  "noEmit": true
  },
  "include": ["./**/*.ts"]
}
