{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
  "module": "NodeNext",
    "moduleResolution": "NodeNext",
  "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/core/**/*.ts"
  ],
  "exclude": [
    "src/**/collector-crypt-database-importer.ts",
    "src/**/collector-crypt-harvester.ts",
    "src/**/resumable-harvester.ts",
    "test",
    "src/**/debug-*.ts",
    "src/**/save-*.ts",
    "src/**/analyze-*.ts"
  ]
}
